# docker-compose.prod.yml — copy to .env and fill in. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

SITE_ADDRESS=gym.example.com          # public domain; Caddy gets the HTTPS certificate
APP_BASE_URL=https://gym.example.com  # used in magic links
APP_VERSION=0.1.0

DB_OWNER_PASSWORD=change-me           # migrations and operator commands
DB_API_PASSWORD=change-me-too         # the API's restricted login (gymspot_api)

JWT_SECRET=
QR_MASTER_SECRET=                     # changing it invalidates every phone delegation and station key
CALIBRATION_ENCRYPTION_KEY=           # exactly 32 bytes, base64url; losing it makes recordings unreadable
