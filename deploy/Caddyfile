# SITE_ADDRESS: the public domain (automatic HTTPS), or ":80" behind another TLS proxy.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * /srv
		# hashed assets can be cached forever; index.html and the service worker never
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh path /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# camera on our own origin only; the microphone is never used (specs/07)
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# MediaPipe WASM/model still come from these CDNs until self-hosting is decided (specs/02 T2.2)
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; connect-src 'self' https://cdn.jsdelivr.net https://storage.googleapis.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		-Server
	}
}
