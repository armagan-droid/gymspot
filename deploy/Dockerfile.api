# API image (specs/02: container, single region). Build from the repo root:
#   docker build -f deploy/Dockerfile.api -t gymspot-api .
FROM node:24-slim AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @gymspot/api build \
 && node -p "require('./apps/api/package.json').dependencies['@node-rs/argon2'].replace(/^[^0-9]*/, '')" > /argon2-version

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /argon2-version /tmp/argon2-version
# the only runtime dependency outside the bundle: the native Argon2 binding
RUN npm init -y >/dev/null && npm install --omit=dev --no-audit --no-fund "@node-rs/argon2@$(cat /tmp/argon2-version)" \
 && rm /tmp/argon2-version && mkdir -p /app/data/calibration && chown -R node:node /app/data
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/exercises ./exercises
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--enable-source-maps", "dist/server.mjs"]
