{
  "id": "mae_geri",
  "version": 1,
  "status": "draft",
  "name": {
    "tr": "Mae geri (Karate)",
    "en": "Mae geri (Karate)"
  },
  "type": "reps",
  "camera": {
    "views": [
      "side"
    ],
    "minVisibleLandmarks": [
      "near_shoulder",
      "near_wrist",
      "near_hip",
      "near_knee",
      "near_ankle"
    ],
    "minVisibility": 0.6,
    "posture": "standing",
    "setupHint": {
      "tr": "Kamerayı bel hizasına, yanına koy; 2–3 metre uzaklaş, gard al.",
      "en": "Place the camera at waist height at your side, step back 2–3 meters and take your guard."
    }
  },
  "metrics": {
    "kick_height_l": {
      "diffY": [
        "left_ankle",
        "left_hip"
      ]
    },
    "kick_height_r": {
      "diffY": [
        "right_ankle",
        "right_hip"
      ]
    },
    "kick_height": {
      "max": [
        "kick_height_l",
        "kick_height_r"
      ]
    },
    "guard_near": {
      "diffY": [
        "near_wrist",
        "near_shoulder"
      ]
    },
    "torso_lean": {
      "angleFromVertical": [
        "near_hip",
        "near_shoulder"
      ]
    }
  },
  "rep": {
    "metric": "kick_height",
    "start": {
      "enter": -1.4,
      "exit": -1.2
    },
    "target": {
      "enter": -0.1,
      "exit": -0.3
    },
    "attemptMinExcursion": 0.2,
    "minDurationMs": 200,
    "maxDurationMs": 3000
  },
  "readyPose": "guard_near > -0.3 for 1000ms",
  "faults": [
    {
      "id": "guard_dropped",
      "name": {
        "tr": "Gardın düşmesi",
        "en": "Guard dropped"
      },
      "severity": "minor",
      "check": "during_rep: guard_near < -0.5",
      "cue": {
        "tr": "Gardını kaldır",
        "en": "Keep your guard up"
      },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 1,
      "holdMs": 200
    },
    {
      "id": "excessive_lean",
      "name": {
        "tr": "Gövdenin aşırı yaslanması",
        "en": "Excessive lean"
      },
      "severity": "minor",
      "check": "at_turn: torso_lean > 30",
      "cue": {
        "tr": "Gövdeni dik tut, geriye yaslanma",
        "en": "Keep your torso upright, don't lean back"
      },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 2
    }
  ],
  "smoothing": {
    "method": "one_euro",
    "minCutoff": 3.0,
    "beta": 1.0
  }
}
