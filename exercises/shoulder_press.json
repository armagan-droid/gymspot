{
  "id": "shoulder_press",
  "version": 1,
  "status": "draft",
  "name": { "tr": "Omuz Press (ayakta, dambıl)", "en": "Standing Dumbbell Shoulder Press" },
  "type": "reps",
  "camera": {
    "views": ["front", "side"],
    "minVisibleLandmarks": ["near_shoulder", "near_elbow", "near_wrist", "near_hip"],
    "minVisibility": 0.6,
    "setupHint": {
      "tr": "Kameraya dön, 2-3 metre uzaklaş; başının üstü ve kolların tam görünsün.",
      "en": "Face the camera from 2-3 meters, with your head and arms fully visible."
    }
  },
  "metrics": {
    "elbow_angle_l": { "angle": ["left_shoulder", "left_elbow", "left_wrist"] },
    "elbow_angle_r": { "angle": ["right_shoulder", "right_elbow", "right_wrist"] },
    "elbow_angle_near": { "angle": ["near_shoulder", "near_elbow", "near_wrist"] },
    "torso_lean": { "angleFromVertical": ["near_hip", "near_shoulder"] },
    "arm_symmetry": { "absDiff": ["elbow_angle_l", "elbow_angle_r"] }
  },
  "rep": {
    "metric": "elbow_angle_near",
    "start": { "enter": 95, "exit": 105 },
    "target": { "enter": 160, "exit": 150 },
    "attemptMinExcursion": 20,
    "minDurationMs": 900,
    "maxDurationMs": 9000
  },
  "readyPose": "elbow_angle_near < 100 for 1500ms",
  "faults": [
    {
      "id": "incomplete_lockout",
      "name": { "tr": "Eksik uzatma", "en": "Incomplete lockout" },
      "severity": "minor",
      "check": "at_turn: elbow_angle_near < 160",
      "cue": { "tr": "Kollarını tamamen yukarı uzat", "en": "Press all the way up" },
      "affectsValidity": true,
      "cooldownMs": 4000,
      "minConsecutiveReps": 1
    },
    {
      "id": "back_arch",
      "name": { "tr": "Bel yaylanması", "en": "Back arch" },
      "severity": "major",
      "check": "during_rep: torso_lean > 12",
      "views": ["side"],
      "cue": { "tr": "Belini yaylandırma, karnını sık", "en": "Don't arch your back, brace your core" },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 2
    },
    {
      "id": "uneven_arms",
      "name": { "tr": "Kolların asimetrisi", "en": "Uneven arms" },
      "severity": "minor",
      "check": "during_rep: arm_symmetry > 25",
      "views": ["front"],
      "cue": { "tr": "İki kolu eşit it", "en": "Press both arms evenly" },
      "affectsValidity": false,
      "cooldownMs": 5000,
      "minConsecutiveReps": 2
    }
  ],
  "smoothing": { "method": "one_euro", "minCutoff": 1.0, "beta": 0.05 }
}
