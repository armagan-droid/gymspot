{
  "id": "squat",
  "version": 1,
  "status": "draft",
  "name": { "tr": "Squat", "en": "Squat" },
  "type": "reps",
  "camera": {
    "views": ["front", "side"],
    "minVisibleLandmarks": ["near_hip", "near_knee", "near_ankle", "near_shoulder"],
    "minVisibility": 0.6,
    "setupHint": {
      "tr": "Kamerayı kalça hizasına koy, 2-3 metre uzaklaş, tüm vücudun görünsün.",
      "en": "Place the camera at hip height, step back 2-3 meters so your whole body is visible."
    }
  },
  "metrics": {
    "knee_angle_l": { "angle": ["left_hip", "left_knee", "left_ankle"] },
    "knee_angle_r": { "angle": ["right_hip", "right_knee", "right_ankle"] },
    "knee_angle_avg": { "avg": ["knee_angle_l", "knee_angle_r"] },
    "torso_lean": { "angleFromVertical": ["near_hip", "near_shoulder"] },
    "knee_valgus_l": { "kneeInwardRatio": ["left_hip", "left_knee", "left_ankle"] },
    "knee_valgus_r": { "kneeInwardRatio": ["right_hip", "right_knee", "right_ankle"] }
  },
  "rep": {
    "metric": "knee_angle_avg",
    "start": { "enter": 160, "exit": 150 },
    "target": { "enter": 100, "exit": 110 },
    "attemptMinExcursion": 20,
    "minDurationMs": 800,
    "maxDurationMs": 8000
  },
  "readyPose": "knee_angle_avg > 165 for 1500ms",
  "faults": [
    {
      "id": "insufficient_depth",
      "severity": "minor",
      "check": "at_turn: knee_angle_avg > 100",
      "cue": { "tr": "Biraz daha aşağı in", "en": "Go a little lower" },
      "affectsValidity": true,
      "cooldownMs": 4000,
      "minConsecutiveReps": 1
    },
    {
      "id": "knee_valgus",
      "severity": "major",
      "check": "during_rep: knee_valgus_l > 0.15 or knee_valgus_r > 0.15",
      "views": ["front"],
      "cue": { "tr": "Dizlerini dışarı aç", "en": "Push your knees out" },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 1
    },
    {
      "id": "excessive_forward_lean",
      "severity": "minor",
      "check": "at_turn: torso_lean > 55",
      "views": ["side"],
      "cue": { "tr": "Göğsünü dik tut", "en": "Keep your chest up" },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 2
    }
  ],
  "smoothing": { "method": "one_euro", "minCutoff": 1.0, "beta": 0.05 }
}
