{
  "id": "straight_punch",
  "version": 1,
  "status": "draft",
  "name": {
    "tr": "Düz yumruk (jab / cross / zuki)",
    "en": "Straight punch (jab / cross / zuki)"
  },
  "type": "reps",
  "camera": {
    "views": [
      "side"
    ],
    "minVisibleLandmarks": [
      "near_shoulder",
      "near_elbow",
      "near_wrist",
      "near_hip"
    ],
    "minVisibility": 0.6,
    "posture": "standing",
    "setupHint": {
      "tr": "Kamerayı bel hizasına, yanına koy; 2–3 metre uzaklaş, gard al.",
      "en": "Place the camera at waist height at your side, step back 2–3 meters and take your guard."
    }
  },
  "metrics": {
    "arm_lift_l": {
      "angle": [
        "left_hip",
        "left_shoulder",
        "left_elbow"
      ]
    },
    "arm_lift_r": {
      "angle": [
        "right_hip",
        "right_shoulder",
        "right_elbow"
      ]
    },
    "arm_lift": {
      "max": [
        "arm_lift_l",
        "arm_lift_r"
      ]
    },
    "guard_near": {
      "diffY": [
        "near_wrist",
        "near_shoulder"
      ]
    },
    "torso_lean": {
      "angleFromVertical": [
        "near_hip",
        "near_shoulder"
      ]
    }
  },
  "rep": {
    "metric": "arm_lift",
    "start": {
      "enter": 35,
      "exit": 40
    },
    "target": {
      "enter": 75,
      "exit": 70
    },
    "attemptMinExcursion": 10,
    "minDurationMs": 150,
    "maxDurationMs": 2000
  },
  "readyPose": "guard_near > -0.3 for 1000ms",
  "faults": [
    {
      "id": "guard_dropped",
      "name": {
        "tr": "Gardın düşmesi",
        "en": "Guard dropped"
      },
      "severity": "minor",
      "check": "during_rep: guard_near < -0.5",
      "cue": {
        "tr": "Gardını kaldır",
        "en": "Keep your guard up"
      },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 1,
      "holdMs": 200
    },
    {
      "id": "excessive_lean",
      "name": {
        "tr": "Gövdenin aşırı yaslanması",
        "en": "Excessive lean"
      },
      "severity": "minor",
      "check": "at_turn: torso_lean > 20",
      "cue": {
        "tr": "Gövdeni dengede tut, yumrukla birlikte eğilme",
        "en": "Keep your torso balanced, don't lean with the punch"
      },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 2
    }
  ],
  "smoothing": {
    "method": "one_euro",
    "minCutoff": 3.0,
    "beta": 1.0
  }
}
